# =============================================================================
# AI-PEER API Backend Environment Configuration
#
# ZERO-CREDENTIAL LOCAL TESTING:
# You can leave all GCS and IDENTITY_PLATFORM variables empty to run in offline
# mock mode. The server will use deterministic test OTPs (123456) and serve
# local mock exercise assets.
# =============================================================================

# Server Configuration
PORT=8080
NODE_ENV=development

# Optional: Set to true to explicitly force mock auth even if API keys are set
MOCK_AUTH=true

# Google Cloud Storage Configuration (Required ONLY for production / real GCP)
GCS_PROJECT_ID=ai-peer
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=aipeer_videos
GCS_MODEL_BUCKET=qwenfinetune

# Google Identity Platform (Required ONLY for real SMS 2FA in production)
IDENTITY_PLATFORM_API_KEY=

# Local Firebase Emulator Host (Optional - leave empty for in-memory mock store)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
