# =============================================================================
# AI-PEER Mobile Frontend Environment Configuration
# =============================================================================

# API Base URL
# - Web / Localhost: http://localhost:8080 (or port 8085 if 8080 is occupied)
# - Android Emulator: http://10.0.2.2:8080
# - Physical Android Device over USB/LAN: http://<YOUR_LAN_IP>:8080
# - Production Cloud Run: https://aipeer-api-596437694331.us-central1.run.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Offline / Dev Simulation Toggles
EXPO_PUBLIC_USE_EMULATOR=true
EXPO_PUBLIC_MOCK_LLM=true

# Firebase Client SDK (Mock credentials for local testing, or prod console values)
EXPO_PUBLIC_FIREBASE_API_KEY=mock-api-key-for-local-dev
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost:9099
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ai-peer
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ai-peer.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
